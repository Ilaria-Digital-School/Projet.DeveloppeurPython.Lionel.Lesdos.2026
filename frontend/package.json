{
  "name": "appli-web-budget-frontend",
  "version": "1.0.0",
  "description": "Frontend pour l'application de gestion de budget",
  "private": true,
  "scripts": {
    "dev": "npm run watch:css",
    "build": "npm run build:css",
    "watch:css": "npx @tailwindcss/cli -i ./static/css/input.css -o ./static/css/tailwind.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./static/css/input.css -o ./static/css/tailwind.css --minify",
    "start": "python -m http.server 3000",
    "lint": "eslint static/js/",
    "format": "prettier --write 'static/js/**/*.js' 'static/css/**/*.css'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "alpinejs": "^3.16.2",
    "chart.js": "^4.5.1",
    "flatpickr": "^4.6.13"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
