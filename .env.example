# =======================================
# FICHIER DE CONFIGURATION D'EXEMPLE
# =======================================
# Copiez ce fichier en .env et modifiez les valeurs selon votre environnement.
# NE COMMITTEZ JAMAIS LE FICHIER .env DANS LE VERSIONNEMENT !
# =======================================

# =======================================
# CONFIGURATION DE BASE
# =======================================
# Environnement : development, testing, production
FLASK_ENV=development
FLASK_APP=app
FLASK_DEBUG=1

# =======================================
# SÉCURITÉ
# =======================================
# Générez une clé secrète avec : python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY='votre-cle-secrete-tres-longue-et-securisee-12345'

# Clé CSRF (doit être distincte de SECRET_KEY)
# Générez avec : python -c 'import secrets; print(secrets.token_hex(32))'
CSRF_SECRET_KEY='votre-csrf-secret-key-distincte-de-secret-key'
WTF_CSRF_SECRET_KEY='votre-csrf-secret-key-distincte-de-secret-key'

# Sel pour le hachage des mots de passe (obligatoire)
# Générez avec : python -c 'import secrets; print(secrets.token_hex(32))'
SECURITY_PASSWORD_SALT='votre-salt-aleatoire-a-changer'

# Configuration JWT
JWT_SECRET_KEY='votre-jwt-secret-key-12345'
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 heure
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 jours

# =======================================
# BASE DE DONNÉES (PostgreSQL obligatoire)
# =======================================
# Docker (par défaut) : host = "db" (nom du service docker-compose)
DATABASE_URL=postgresql://budget_user:password@db:5432/budget

# Local (sans Docker) : décommenter et commenter la ligne ci-dessus
# DATABASE_URL=postgresql://budget_user:password@localhost:5432/budget

# Variables utilisées par le conteneur PostgreSQL (Docker)
POSTGRES_DB=budget
POSTGRES_USER=budget_user
POSTGRES_PASSWORD=password

# Base de données de test (utilisée par pytest)
# DATABASE_URL_TEST=postgresql://budget_user:password@localhost:5432/budget_test

# =======================================
# CACHE ET SESSIONS
# =======================================
# Redis (requis pour le cache et le rate limiting)
# Docker (par défaut) : host = "redis" (nom du service docker-compose)
REDIS_URL=redis://redis:6379/0
# Local (sans Docker) : REDIS_URL=redis://localhost:6379/0

# Type de cache : simple, redis, memcached, etc.
CACHE_TYPE=redis
CACHE_REDIS_URL=${REDIS_URL}
CACHE_DEFAULT_TIMEOUT=300  # 5 minutes

# =======================================
# EMAIL
# =======================================
MAIL_SERVER=ssl0.ovh.net
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=contact@example.com
MAIL_PASSWORD=votre-mot-de-passe-smtp
MAIL_DEFAULT_SENDER='Budget App <contact@example.com>'
MAIL_DEBUG=0

# =======================================
# LIMITATION DE DÉBIT (RATE LIMITING)
# =======================================
RATELIMIT_STORAGE_URL=${REDIS_URL}
RATELIMIT_STRATEGY=moving-window
RATELIMIT_HEADERS_ENABLED=1

# =======================================
# INTERNATIONALISATION
# =======================================
BABEL_DEFAULT_LOCALE=fr
BABEL_DEFAULT_TIMEZONE=Europe/Paris
SUPPORTED_LANGUAGES=fr,en,es

# =======================================
# DÉBOGAGE ET JOURNALISATION
# =======================================
LOG_LEVEL=INFO
LOG_FORMAT='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
LOG_FILE=logs/app.log

# =======================================
# DÉPLOIEMENT
# =======================================
# Configuration Gunicorn (production)
WORKERS=4
THREADS=2
TIMEOUT=120

# Configuration Sentry (surveillance des erreurs)
# SENTRY_DSN=https://votre-clé@sentry.io/votre-projet

# =======================================
# RAILWAY (PaaS)
# =======================================
# Les variables suivantes sont fournies automatiquement par Railway :
#   DATABASE_URL  — URL PostgreSQL de l'add-on Railway
#   REDIS_URL     — URL Redis de l'add-on Railway
#   PORT          — Port sur lequel Gunicorn doit écouter
#
# Il suffit de définir les secrets dans le dashboard Railway :
#   SECRET_KEY, JWT_SECRET_KEY, SECURITY_PASSWORD_SALT,
#   WTF_CSRF_SECRET_KEY, CSRF_SECRET_KEY, MAIL_PASSWORD

# =======================================
# DÉVELOPPEMENT
# =======================================
# Protection CSRF — ne désactiver qu'en tests automatisés, jamais en dev manuel
WTF_CSRF_ENABLED=True

# Active le mode débogage de SQLAlchemy
SQLALCHEMY_ECHO=False
SQLALCHEMY_RECORD_QUERIES=True

# =======================================
# FICHIERS MÉDIAS
# =======================================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16 * 1024 * 1024  # 16 Mo
ALLOWED_EXTENSIONS={'png', 'jpg', 'jpeg', 'gif', 'pdf'}

# =======================================
# SÉCURITÉ SUPPLÉMENTAIRE
# =======================================
# Configuration CORS — NE JAMAIS utiliser * en production !
CORS_ORIGINS=http://localhost:5000,http://localhost:3000
CORS_SUPPORTS_CREDENTIALS=True

# Configuration de sécurité des en-têtes HTTP
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE='Lax'

# Protection contre les attaques CSRF
WTF_CSRF_TIME_LIMIT=3600  # 1 heure

# =======================================
# MÉTRIQUES ET SURVEILLANCE
# =======================================
# Prometheus (métriques)
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_METRICS_ENABLED=True

# =======================================
# CONFIGURATION SPÉCIFIQUE À L'APPLICATION
# =======================================
# URL de base de l'API (pour la génération des URLs absolues)
API_BASE_URL=http://localhost:5000/api

# Configuration des rôles par défaut
DEFAULT_ROLE=user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=  # OBLIGATOIRE: mot de passe fort (12+ chars, maj, chiffre, special). Si vide, un aleatoire sera genere.

# =======================================
# CONFIGURATION DES TIERS
# =======================================
# Configuration pour les services externes (ex: Stripe, SendGrid, etc.)
# STRIPE_SECRET_KEY=sk_test_...
# SENDGRID_API_KEY=SG...
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...
# FACEBOOK_OAUTH_CLIENT_ID=...
# FACEBOOK_OAUTH_CLIENT_SECRET=...

# =======================================
# CONFIGURATION AVANCÉE
# =======================================
# Ne modifiez pas ces valeurs sauf si vous savez ce que vous faites
SQLALCHEMY_TRACK_MODIFICATIONS=False
PROPAGATE_EXCEPTIONS=False
JSON_SORT_KEYS=False
JSON_AS_ASCII=False

# =======================================
# DÉPANNAGE
# =======================================
# Pour le débogage des problèmes de connexion à la base de données
# SQLALCHEMY_ECHO=True
# SQLALCHEMY_ENGINE_OPTIONS='{"echo": true, "echo_pool": true}'

# Pour forcer le rechargement des templates à chaque requête
# TEMPLATES_AUTO_RELOAD=True
